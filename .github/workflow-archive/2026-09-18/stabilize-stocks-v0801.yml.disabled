name: Stabilize Stocks v0.8.0.1

on:
  push:
    paths:
      - '.github/workflows/stabilize-stocks-v0801.yml'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  stabilize:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Apply Stocks stabilization
        run: python3 .github/scripts/stabilize_stocks_v0801.py
      - name: Validate Stocks only
        run: |
          node --check SakaLuX-Stock-Manager-Advisor.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      0.8.0.1' SakaLuX-Stock-Manager-Advisor.user.js
          grep -q "version:'0.8.0.1'" SakaLuX-Stock-Manager-Advisor.user.js
          grep -q 'SAKALUX_STOCK_STABILIZATION_V0801' SakaLuX-Stock-Manager-Advisor.user.js
          grep -q 'v0.8.0.1' greasyfork/Stock-Manager-Advisor.md
          git diff --exit-code -- SakaLuX-Company-Intelligence-v1.0.0.user.js
      - name: Commit Stocks stabilization
        run: |
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add SakaLuX-Stock-Manager-Advisor.user.js scripts.json greasyfork/Stock-Manager-Advisor.md backups/stocks-v0.8.0.1-stabilization-2026-09-18
          git diff --cached --quiet && exit 0
          git commit -m 'Stocks v0.8.0.1: stabilization and TornPDA polish'
          git push
