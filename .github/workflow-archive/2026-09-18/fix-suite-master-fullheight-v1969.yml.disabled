name: Fix Suite Master Control full height v1.9.69

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/fix-suite-master-fullheight-v1969.yml'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2

      - name: Patch Hub
        shell: python
        run: |
          from pathlib import Path
          import shutil
          p=Path('SakaLuX-Script-Hub.user.js')
          s=p.read_text(encoding='utf-8')
          old='1.9.68'; new='1.9.69'
          if f'// @version      {new}' in s:
              print('already patched')
          else:
              if f'// @version      {old}' not in s:
                  raise SystemExit('unexpected Hub version')
              b=Path('backups/hub-suite-master-fullheight-2026-09-17/SakaLuX-Script-Hub-v1.9.68.user.js')
              b.parent.mkdir(parents=True, exist_ok=True)
              shutil.copy2(p,b)
              s=s.replace(f'// @version      {old}',f'// @version      {new}',1)
              s += r'''

/* SakaLuX Hub v1.9.69 - force Suite Master Control to use the full TornPDA viewport */
(()=>{
  'use strict';
  const imp=(el,p,v)=>{if(el)el.style.setProperty(p,v,'important')};
  const text=el=>(el?.innerText||el?.textContent||'').replace(/\s+/g,' ').trim();
  function findPanel(){
    const all=[...document.querySelectorAll('div,section,aside')].filter(el=>{const t=text(el);return t.includes('MASTER CONTROL')&&t.includes('SakaLuX Suite')&&t.includes('Enable Ready Modules')});
    if(!all.length)return null;
    all.sort((a,b)=>a.getBoundingClientRect().width*a.getBoundingClientRect().height-b.getBoundingClientRect().width*b.getBoundingClientRect().height);
    return all.find(el=>{const r=el.getBoundingClientRect();return r.width>300&&r.height>250&&getComputedStyle(el).display!=='none'})||all[0];
  }
  function direct(root,node){let n=node;while(n&&n.parentElement!==root)n=n.parentElement;return n&&n.parentElement===root?n:null}
  function apply(){
    const panel=findPanel();if(!panel)return;
    panel.dataset.slxMasterFullheightV1969='1';
    [['position','fixed'],['top','0'],['left','4px'],['right','4px'],['bottom','36px'],['inset','0 4px 36px 4px'],['width','auto'],['height','auto'],['max-width','none'],['max-height','none'],['min-height','0'],['margin','0'],['transform','none'],['display','flex'],['flex-direction','column'],['overflow','hidden'],['box-sizing','border-box'],['border-radius','14px'],['z-index','2147483000']].forEach(([p,v])=>imp(panel,p,v));
    const footerLeaf=[...panel.querySelectorAll('div,footer,section')].find(el=>{const t=text(el);return t.includes('SEND MONEY')&&t.includes('SEND ITEMS')&&t.includes('Made with')});
    const footer=footerLeaf?direct(panel,footerLeaf):null;
    if(footer){imp(footer,'flex','0 0 auto');imp(footer,'margin-top','auto');imp(footer,'position','relative');imp(footer,'width','100%')}
    const titleLeaf=[...panel.querySelectorAll('div,header,section')].find(el=>{const t=text(el);return t.includes('MASTER CONTROL')&&t.includes('SakaLuX Suite')&&!t.includes('Enable Ready Modules')});
    const header=titleLeaf?direct(panel,titleLeaf):null;if(header){imp(header,'flex','0 0 auto');imp(header,'position','relative')}
    const directKids=[...panel.children].filter(el=>el!==header&&el!==footer);
    const actionsLeaf=[...panel.querySelectorAll('div,section')].find(el=>{const t=text(el);return t.includes('Enable Ready Modules')&&t.includes('Disable All')&&t.includes('Export Settings')&&t.includes('Import Settings')});
    const actions=actionsLeaf?direct(panel,actionsLeaf):null;if(actions){imp(actions,'flex','0 0 auto');imp(actions,'position','relative')}
    const middle=directKids.find(el=>el!==actions&&el.scrollHeight>el.clientHeight)||directKids.find(el=>el!==actions);
    if(middle){imp(middle,'flex','1 1 0');imp(middle,'min-height','0');imp(middle,'overflow-y','auto');imp(middle,'overflow-x','hidden');imp(middle,'-webkit-overflow-scrolling','touch')}
  }
  let raf=0;const schedule=()=>{cancelAnimationFrame(raf);raf=requestAnimationFrame(apply)};
  new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true,attributes:true,attributeFilter:['style','class']});
  addEventListener('resize',schedule,{passive:true});addEventListener('orientationchange',schedule,{passive:true});setInterval(apply,1200);apply();
})();
'''
              p.write_text(s,encoding='utf-8')

      - name: Validate
        shell: python
        run: |
          from pathlib import Path
          s=Path('SakaLuX-Script-Hub.user.js').read_text(encoding='utf-8')
          for x in ['// @version      1.9.69','slxMasterFullheightV1969',"['bottom','36px']"]:
              if x not in s: raise SystemExit('missing '+x)
          print('validated')

      - name: Commit
        run: |
          git config user.name "SakaLuX Release Bot"
          git config user.email "actions@users.noreply.github.com"
          git add SakaLuX-Script-Hub.user.js backups/hub-suite-master-fullheight-2026-09-17/
          if git diff --cached --quiet; then echo "Nothing to commit"; else git commit -m "Hub v1.9.69: force Suite Master Control full-height on TornPDA" && git push; fi
