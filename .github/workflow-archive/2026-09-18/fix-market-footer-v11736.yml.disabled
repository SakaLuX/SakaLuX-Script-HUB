name: Market v1.17.36 footer restore

on:
  push:
    paths:
      - '.github/fix-market-footer-v11736.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Backup current release
        shell: bash
        run: |
          set -euo pipefail
          B='backups/market-v1.17.36-footer-restore-2026-09-17'
          mkdir -p "$B/greasyfork"
          cp SakaLuX-Market-Intelligence.user.js "$B/SakaLuX-Market-Intelligence-v1.17.35.user.js"
          cp SakaLuX-Script-Hub.user.js "$B/SakaLuX-Script-Hub-before-market-1.17.36.user.js"
          cp scripts.json "$B/scripts.json"
          cp greasyfork/Market-Intelligence.md "$B/greasyfork/Market-Intelligence-v1.17.35.md"
          cp greasyfork/Script-Hub.md "$B/greasyfork/Script-Hub.md"
          [ -f RELEASE-PERFORMANCE-AUDIT-2026-09-17.md ] && cp RELEASE-PERFORMANCE-AUDIT-2026-09-17.md "$B/RELEASE-PERFORMANCE-AUDIT-2026-09-17.md" || true

      - name: Restore Market native footer
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import json, re

          # Market userscript
          p=Path('SakaLuX-Market-Intelligence.user.js')
          s=p.read_text()
          if '// @version      1.17.35' not in s:
              raise SystemExit('Market header is not v1.17.35')
          s=s.replace('// @version      1.17.35','// @version      1.17.36',1)
          s=s.replace("const VERSION='1.17.35'","const VERSION='1.17.36'")
          s=s.replace('const VERSION = \'1.17.35\'','const VERSION = \'1.17.36\'')
          s=s.replace('version:\'1.17.35\'','version:\'1.17.36\'')
          old="const panel=document.querySelector(selector);if(!panel||panel.closest('#sakalux-hub-overlay, #sakalux-hub-panel'))return;"
          new="const panel=document.querySelector(selector);if(!panel)return;"
          if old not in s:
              raise SystemExit('Market footer Hub-subtree guard not found')
          s=s.replace(old,new,1)
          p.write_text(s)

          # Registry
          p=Path('scripts.json')
          data=json.loads(p.read_text())
          found=False
          def walk(x):
              global found
              if isinstance(x,dict):
                  if x.get('id')=='market-intelligence':
                      x['version']='1.17.36'
                      rel=x.setdefault('release',{})
                      rel['version']='1.17.36'
                      rel['date']='2026-09-17'
                      rel['notes']=['Restores the native Market donation/author footer when Market settings are opened from Script Hub.','Keeps exactly one footer: SEND MONEY, SEND ITEMS, and Made with ❤️ by SakaLuX [2380374].','Removes the over-broad Hub-subtree guard that suppressed the Market-owned footer.']
                      found=True
                  for v in x.values(): walk(v)
              elif isinstance(x,list):
                  for v in x: walk(v)
          walk(data)
          if not found: raise SystemExit('market-intelligence registry entry not found')
          p.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n')

          # Hub offline fallback metadata only; do not change Hub runtime version.
          p=Path('SakaLuX-Script-Hub.user.js')
          h=p.read_text()
          h=h.replace("name: 'Market Intelligence', icon: '📈', category: 'Trading', version: '1.17.35'","name: 'Market Intelligence', icon: '📈', category: 'Trading', version: '1.17.36'",1)
          h=h.replace("version: '1.17.35',\n                description:","version: '1.17.36',\n                description:",1)
          h=h.replace("version:'1.17.35'","version:'1.17.36'")
          h=h.replace("version: '1.17.35'","version: '1.17.36'")
          # Update the Market fallback release object if present.
          h=h.replace("release: { version: '1.17.35'","release: { version: '1.17.36'",1)
          p.write_text(h)

          # Market documentation
          p=Path('greasyfork/Market-Intelligence.md')
          m=p.read_text()
          m=m.replace('**v1.17.35**','**v1.17.36**',1)
          marker='## Current release note\n'
          note='\n**v1.17.36** restores the native Market footer when Market settings are opened from Script Hub. The over-broad Hub-subtree guard was removed, so the panel again shows `SEND MONEY`, `SEND ITEMS`, and one `Made with ❤️ by SakaLuX [2380374]` line. Hub still suppresses its generic fallback inside Market, preventing duplication.\n'
          if marker not in m: raise SystemExit('Market release note marker missing')
          m=m.replace(marker,marker+note,1)
          hist='## Release history / Changelog\n'
          entry='\n### v1.17.36 — Restore native Market footer\n- Restores SEND MONEY / SEND ITEMS and the Made with ❤️ author line inside Market settings opened through Hub.\n- Removes the Market footer guard that incorrectly treated Hub-launched Market settings as a Hub-owned panel.\n- Keeps Hub generic footer suppression for Market, so only one footer remains.\n'
          if hist not in m: raise SystemExit('Market history marker missing')
          m=m.replace(hist,hist+entry,1)
          p.write_text(m)

          # Script Hub documentation: update registered module version only.
          p=Path('greasyfork/Script-Hub.md')
          d=p.read_text().replace('SakaLuX Market Intelligence **v1.17.35**','SakaLuX Market Intelligence **v1.17.36**')
          p.write_text(d)

          # Audit table
          p=Path('RELEASE-PERFORMANCE-AUDIT-2026-09-17.md')
          if p.exists():
              a=p.read_text().replace('| SakaLuX-Market-Intelligence.user.js | 1.17.35 |','| SakaLuX-Market-Intelligence.user.js | 1.17.36 |')
              p.write_text(a)
          PY

      - name: Validate
        shell: bash
        run: |
          set -euo pipefail
          node --check SakaLuX-Market-Intelligence.user.js
          node --check SakaLuX-Script-Hub.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      1.17.36' SakaLuX-Market-Intelligence.user.js
          grep -q "const panel=document.querySelector(selector);if(!panel)return;" SakaLuX-Market-Intelligence.user.js
          ! grep -q "panel.closest('#sakalux-hub-overlay, #sakalux-hub-panel')" SakaLuX-Market-Intelligence.user.js
          grep -q '"version": "1.17.36"' scripts.json
          grep -q '\*\*v1.17.36\*\*' greasyfork/Market-Intelligence.md
          grep -q "panel.matches('#sl-mi-panel')" SakaLuX-Script-Hub.user.js

      - name: Commit release
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add SakaLuX-Market-Intelligence.user.js SakaLuX-Script-Hub.user.js scripts.json greasyfork/Market-Intelligence.md greasyfork/Script-Hub.md backups/market-v1.17.36-footer-restore-2026-09-17/
          [ -f RELEASE-PERFORMANCE-AUDIT-2026-09-17.md ] && git add RELEASE-PERFORMANCE-AUDIT-2026-09-17.md || true
          git commit -m 'Market v1.17.36: restore native footer in Hub-launched settings'
          git push
