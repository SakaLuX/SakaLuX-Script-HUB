name: Recover Suite v0.9.924

on:
  push:
    paths:
      - '.github/recover-suite-v0924.trigger'

permissions:
  contents: write

jobs:
  recover:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Restore last working Suite and publish hotfix
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p backups/suite-v0923-open-regression-2026-09-17
          cp SakaLuX-Suite.user.js backups/suite-v0923-open-regression-2026-09-17/SakaLuX-Suite-v0.9.923.user.js
          cp greasyfork/SakaLuX-Suite.md backups/suite-v0923-open-regression-2026-09-17/SakaLuX-Suite-v0.9.923.md

          git checkout 30fa82d05eadbd2d3e797e1bdbda2552b391ea46^ -- SakaLuX-Suite.user.js greasyfork/SakaLuX-Suite.md

          python3 - <<'PY'
          from pathlib import Path

          p = Path('SakaLuX-Suite.user.js')
          s = p.read_text()
          s = s.replace('// @version      0.9.922', '// @version      0.9.924', 1)
          s = s.replace("const VERSION = '0.9.922';", "const VERSION = '0.9.924';", 1)
          p.write_text(s)

          p = Path('greasyfork/SakaLuX-Suite.md')
          s = p.read_text()
          s = s.replace('**v0.9.922**', '**v0.9.924**', 1)
          marker = '## Current release note\n'
          note = '\n**v0.9.924** emergency hotfix restores the last working Master Control runtime after v0.9.923 prevented the Suite launcher from opening in TornPDA. The v0.9.923 coarse-pointer full-height override has been removed completely; launcher behavior is restored first, while the mobile-height adjustment will be reworked separately without touching the open path.\n'
          if marker in s:
              s = s.replace(marker, marker + note, 1)
          p.write_text(s)
          PY

      - name: Validate JavaScript syntax
        run: node --check SakaLuX-Suite.user.js

      - name: Commit recovery
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add SakaLuX-Suite.user.js greasyfork/SakaLuX-Suite.md backups/suite-v0923-open-regression-2026-09-17/
          git commit -m 'Suite v0.9.924: restore launcher after TornPDA regression'
          git push
