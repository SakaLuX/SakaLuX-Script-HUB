name: Publish Suite v0.9.927
on:
  push:
    branches: [main]
    paths: ['.github/workflows/release-suite-v0927.yml']
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: suite-release-v0927
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Apply reviewed Suite module update
        run: |
          if grep -Eq '^// @version +0\.9\.926$' SakaLuX-Suite.user.js; then
            test "$(git hash-object SakaLuX-Suite.user.js)" = '729c82a28ede1d0e1b8fb1814a152f346578b9cb'
            git apply --check releases/suite-v0.9.927.patch
            git apply releases/suite-v0.9.927.patch
          fi
      - name: Validate repository and Suite bridges
        run: |
          python3 -m pip install PyYAML==6.0.3
          npm install --prefix "$RUNNER_TEMP/dom-tests" jsdom@30.1.0 --no-audit --no-fund
          python3 .github/scripts/validate_repository.py
          NODE_PATH="$RUNNER_TEMP/dom-tests/node_modules" node tests/suite-modules-regression.cjs
          grep -Eq '^// @version +0\.9\.927$' SakaLuX-Suite.user.js
      - name: Commit validated update
        run: |
          if ! git diff --quiet; then
            git config user.name 'SakaLuX Release Bot'
            git config user.email 'actions@users.noreply.github.com'
            git add SakaLuX-Suite.user.js
            git commit -m 'Suite v0.9.927: complete all nine SakaLuX tool bridges'
            git push origin HEAD:main
          fi
      - name: Prepare complete userscript and backup
        run: |
          mkdir -p dist
          cp SakaLuX-Suite.user.js dist/SakaLuX-Suite-v0.9.927.user.js
          cp releases/suite-v0.9.927.md dist/CHANGELOG-Suite-v0.9.927.md
          zip -j dist/SakaLuX-Suite-v0.9.926-backup.zip backups/suite-modules-v0.9.927-2026-09-18/*
          (cd dist && sha256sum *.user.js *.md *.zip > SHA256SUMS.txt)
      - name: Publish validated release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          if gh release view suite-v0.9.927 >/dev/null 2>&1; then
            gh release upload suite-v0.9.927 dist/* --clobber
          else
            gh release create suite-v0.9.927 dist/* --target "$(git rev-parse HEAD)" --title 'SakaLuX Suite v0.9.927 — Complete tool bridges' --notes-file releases/suite-v0.9.927.md --prerelease --latest=false
          fi
