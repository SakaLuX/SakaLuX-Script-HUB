name: Verify final mobile CPU workload
on:
  push:
    branches: [main]
    paths: ['tests/performance/extended-browser.cjs', '.github/workflows/final-mobile-cpu.yml', 'SakaLuX-Market-Intelligence.user.js']
  workflow_dispatch:
permissions:
  contents: write
jobs:
  measure:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Install pinned Chromium dependencies
        run: |
          npm install --prefix "$RUNNER_TEMP/cpu-tests" playwright@1.62.1 --no-audit --no-fund
          "$RUNNER_TEMP/cpu-tests/node_modules/.bin/playwright" install --with-deps chromium
      - name: Verify published Suite source
        run: head -10 SakaLuX-Suite.user.js | grep '@version.*0.9.929'
      - name: Compare all twelve current scripts at six-times CPU throttling
        env:
          NODE_PATH: ${{ runner.temp }}/cpu-tests/node_modules
        run: node tests/performance/extended-browser.cjs
      - name: Save exact measured report against current main
        run: |
          preserved="$RUNNER_TEMP/browser-current.json"
          cp reports/extended-performance-2026-09-18/browser-current.json "$preserved"
          git fetch origin main
          git reset --hard origin/main
          cp "$preserved" reports/extended-performance-2026-09-18/browser-current.json
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add reports/extended-performance-2026-09-18/browser-current.json
          git commit -m 'Record actual mobile viewport CPU samples for all final userscripts'
          git push origin HEAD:main
