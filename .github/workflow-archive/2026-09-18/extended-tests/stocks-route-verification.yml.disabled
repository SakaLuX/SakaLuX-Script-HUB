name: Verify Stocks return deadline
on:
  push:
    branches: [main]
    paths: ['tests/performance/stocks-route-browser.cjs', '.github/workflows/stocks-route-verification.yml']
  workflow_dispatch:
permissions:
  contents: write
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Install pinned Chromium dependencies
        run: |
          npm install --prefix "$RUNNER_TEMP/stock-routes" playwright@1.62.1 --no-audit --no-fund
          "$RUNNER_TEMP/stock-routes/node_modules/.bin/playwright" install --with-deps chromium
      - name: Measure all 100 return deadlines
        env:
          NODE_PATH: ${{ runner.temp }}/stock-routes/node_modules
        run: |
          node tests/performance/stocks-route-browser.cjs
          python3 - <<'PY'
          import json
          from pathlib import Path
          r=json.loads(Path('reports/extended-performance-2026-09-18/stocks-route-verification.json').read_text())
          assert r['assertions'] and all(x['passed'] for x in r['assertions'])
          PY
      - name: Preserve original findings and append timed verification
        run: |
          preserved="$RUNNER_TEMP/stocks-route-verification.json"
          cp reports/extended-performance-2026-09-18/stocks-route-verification.json "$preserved"
          git fetch origin main
          git reset --hard origin/main
          cp "$preserved" reports/extended-performance-2026-09-18/stocks-route-verification.json
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add reports/extended-performance-2026-09-18/stocks-route-verification.json
          git commit -m 'Record all Stocks return latencies and preserve original 65ms misses'
          git push origin HEAD:main
