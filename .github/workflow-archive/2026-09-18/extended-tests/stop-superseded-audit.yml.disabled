name: Stop superseded audit
on:
  push:
    branches: [main]
    paths: ['.github/workflows/stop-superseded-audit.yml']
permissions:
  actions: write
  contents: read
jobs:
  cleanup:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - name: Stop obsolete audit with missing output directory
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          for run_id in 35367436353 35368165358; do
            state=$(gh api repos/SakaLuX/SakaLuX-Script-HUB/actions/runs/$run_id --jq .status)
            if [ "$state" != completed ]; then
              gh api -X POST repos/SakaLuX/SakaLuX-Script-HUB/actions/runs/$run_id/cancel
            fi
          done
