name: Validate and publish performance update
on:
  push:
    branches: [main]
    paths: ['.github/workflows/release-performance-20260918.yml']
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: performance-release-20260918
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Apply reviewed performance update
        run: |
          if grep -Eq '^// @version +0\.9\.927$' SakaLuX-Suite.user.js; then
            test "$(git hash-object SakaLuX-Suite.user.js)" = '69ceae6694338f330df76a185e93675e945a03c9'
            cat releases/performance-2026-09-18.patch.part* > "$RUNNER_TEMP/performance.patch"
            git apply --check "$RUNNER_TEMP/performance.patch"
            git apply "$RUNNER_TEMP/performance.patch"
          fi
          grep -Eq '^// @version +0\.9\.928$' SakaLuX-Suite.user.js
      - name: Install DOM and browser test dependencies
        run: |
          python3 -m pip install PyYAML==6.0.3
          npm install --prefix "$RUNNER_TEMP/perf-tests" jsdom@30.1.0 playwright@1.62.1 --no-audit --no-fund
          "$RUNNER_TEMP/perf-tests/node_modules/.bin/playwright" install --with-deps chromium
      - name: Validate all source, registry and regression checks
        env:
          NODE_PATH: ${{ runner.temp }}/perf-tests/node_modules
        run: |
          python3 .github/scripts/validate_repository.py
          node tests/suite-modules-regression.cjs
          node tests/stocks-panel-regression.cjs
          node tests/hub-details-regression.cjs
          node tests/performance/ui-regression.cjs
          node tests/performance/run.cjs "$RUNNER_TEMP/dom-current.json" --assert
      - name: Benchmark individual and coinstalled scripts in Chromium with limited CPU
        env:
          NODE_PATH: ${{ runner.temp }}/perf-tests/node_modules
        run: node tests/performance/browser.cjs reports/performance-2026-09-18/browser.json
      - name: Commit validated scripts and actual browser measurements
        run: |
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add '*.user.js' greasyfork scripts.json reports/performance-2026-09-18
          if ! git diff --cached --quiet; then
            git commit -m 'Optimize 11 SakaLuX scripts and record all-script performance measurements'
            git push origin HEAD:main
          fi
      - name: Publish complete releases and backups
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: python3 .github/scripts/publish_performance.py
