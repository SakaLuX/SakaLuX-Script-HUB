name: Hub v1.9.70 Market footer dedupe

on:
  push:
    paths:
      - '.github/fix-hub-market-footer-v1969.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Backup and patch
        shell: bash
        run: |
          set -euo pipefail
          B='backups/hub-v1.9.70-market-footer-dedupe-2026-09-17'
          mkdir -p "$B/greasyfork"
          cp SakaLuX-Script-Hub.user.js "$B/SakaLuX-Script-Hub-v1.9.69.user.js"
          cp greasyfork/Script-Hub.md "$B/greasyfork/Script-Hub-v1.9.69.md"
          cp scripts.json "$B/scripts.json"
          [ -f RELEASE-PERFORMANCE-AUDIT-2026-09-17.md ] && cp RELEASE-PERFORMANCE-AUDIT-2026-09-17.md "$B/RELEASE-PERFORMANCE-AUDIT-2026-09-17.md" || true

          python3 - <<'PY'
          from pathlib import Path

          p=Path('SakaLuX-Script-Hub.user.js'); s=p.read_text(); old=s
          if '// @version      1.9.69' not in s: raise SystemExit('Hub header is not v1.9.69')
          s=s.replace('// @version      1.9.69','// @version      1.9.70',1)
          s=s.replace("const VERSION = '1.9.69';","const VERSION = '1.9.70';",1)

          fn=s.find('function ensureManagedModuleFooters()')
          if fn < 0: raise SystemExit('ensureManagedModuleFooters not found')
          pos=s.find('seen.add(panel);',fn)
          if pos < 0 or pos-fn > 5000: raise SystemExit('seen.add(panel) not found in managed footer function')
          pos += len('seen.add(panel);')
          guard="""

                // Market Intelligence owns its complete compact footer. Never inject
                // the older generic author-only fallback into #sl-mi-panel.
                if (panel.matches('#sl-mi-panel')) {
                    const nativeMarketFooter = panel.querySelector('#sakalux-inline-footer-market-intelligence');
                    if (nativeMarketFooter) nativeMarketFooter.classList.add('sakalux-stable-module-footer');
                    return;
                }"""
          if "panel.matches('#sl-mi-panel')" in s[fn:fn+6000]:
              raise SystemExit('Market footer guard already present')
          s=s[:pos]+guard+s[pos:]

          anchor='    const HUB_CHANGELOG = ['
          entry="\n        {version:'1.9.70',date:'2026-09-17',changes:['Prevents Script Hub from injecting its legacy author-only fallback footer into Market Intelligence settings.','Market Intelligence keeps exactly one footer: SEND MONEY, SEND ITEMS, then Made with ❤️ by SakaLuX [2380374].','Preserves Market settings, calculations, cache controls and Suite launcher behavior unchanged.']},"
          if anchor not in s: raise SystemExit('HUB_CHANGELOG anchor missing')
          s=s.replace(anchor,anchor+entry,1)
          if s==old: raise SystemExit('Hub source unchanged')
          p.write_text(s)

          p=Path('greasyfork/Script-Hub.md'); m=p.read_text()
          if '**v1.9.69**' not in m: raise SystemExit('Script-Hub.md current version missing')
          m=m.replace('**v1.9.69**','**v1.9.70**',1)
          marker='## Current release note\n'
          note='\n**v1.9.70** fixes the duplicate author line in Market Intelligence settings. Script Hub no longer injects its generic author-only fallback into `#sl-mi-panel`; Market keeps its native compact footer with `SEND MONEY`, `SEND ITEMS`, and one `Made with ❤️ by SakaLuX [2380374]` line. Market logic and the restored Suite launcher are unchanged.\n'
          if marker not in m: raise SystemExit('Current release note marker missing')
          m=m.replace(marker,marker+note,1)
          p.write_text(m)

          p=Path('RELEASE-PERFORMANCE-AUDIT-2026-09-17.md')
          if p.exists():
              p.write_text(p.read_text().replace('| SakaLuX-Script-Hub.user.js | 1.9.69 |','| SakaLuX-Script-Hub.user.js | 1.9.70 |'))
          PY

      - name: Validate
        shell: bash
        run: |
          set -euo pipefail
          node --check SakaLuX-Script-Hub.user.js
          node --check SakaLuX-Market-Intelligence.user.js
          node --check SakaLuX-Suite.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      1.9.70' SakaLuX-Script-Hub.user.js
          grep -q "const VERSION = '1.9.70';" SakaLuX-Script-Hub.user.js
          grep -q "panel.matches('#sl-mi-panel')" SakaLuX-Script-Hub.user.js
          grep -q "#sakalux-inline-footer-market-intelligence" SakaLuX-Script-Hub.user.js
          grep -q '\*\*v1.9.70\*\*' greasyfork/Script-Hub.md
          test "$(python3 - <<'PY'
          from pathlib import Path
          print(Path('SakaLuX-Market-Intelligence.user.js').read_text().count('Made with ❤️'))
          PY
          )" = '1'

      - name: Commit release
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add SakaLuX-Script-Hub.user.js greasyfork/Script-Hub.md backups/hub-v1.9.70-market-footer-dedupe-2026-09-17/
          [ -f RELEASE-PERFORMANCE-AUDIT-2026-09-17.md ] && git add RELEASE-PERFORMANCE-AUDIT-2026-09-17.md || true
          git commit -m 'Hub v1.9.70: remove duplicate Market author footer'
          git push
