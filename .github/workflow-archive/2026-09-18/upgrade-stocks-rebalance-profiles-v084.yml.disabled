name: Upgrade Stocks v0.8.4 Rebalance Strategy Profiles

on:
  push:
    paths:
      - '.github/workflows/upgrade-stocks-rebalance-profiles-v084.yml'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  upgrade:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Apply v0.8.4
        run: python3 .github/scripts/upgrade-stocks-v084.py
      - name: Validate
        run: |
          node --check SakaLuX-Stock-Manager-Advisor.user.js
          python3 - <<'PY'
          from pathlib import Path
          import json
          s=Path('SakaLuX-Stock-Manager-Advisor.user.js').read_text()
          j=json.loads(Path('scripts.json').read_text())
          e=next(x for x in j['scripts'] if x.get('id')=='stock-manager-advisor')
          assert '// @version      0.8.4' in s
          assert 'SAKALUX_STOCK_REBALANCE_PROFILES_V084' in s
          assert "safe:{id:'safe'" in s
          assert "balanced:{id:'balanced'" in s
          assert "aggressive:{id:'aggressive'" in s
          assert e['version']=='0.8.4'
          assert e['release']['version']=='0.8.4'
          print('Stocks v0.8.4 validation OK')
          PY
      - name: Commit release
        run: |
          git config user.name 'SakaLuX'
          git config user.email 'sakalutzu92@yahoo.com'
          git add SakaLuX-Stock-Manager-Advisor.user.js greasyfork/Stock-Manager-Advisor.md scripts.json backups/stocks-v0.8.4-rebalance-profiles-2026-09-18
          git commit -m 'Stocks v0.8.4: Rebalance Strategy Profiles'
          git push
