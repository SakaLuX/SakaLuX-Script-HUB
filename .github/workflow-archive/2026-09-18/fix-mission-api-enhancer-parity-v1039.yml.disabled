name: Fix Mission API Enhancer Parity v1.0.39

on:
  push:
    paths:
      - '.github/mission-api-enhancer-parity.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Patch Mission API UI
        run: python3 .github/scripts/fix_mission_api_enhancer_parity.py

      - name: Validate
        shell: bash
        run: |
          set -euo pipefail
          node --check SakaLuX-Mission-Rewards.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      1.0.39' SakaLuX-Mission-Rewards.user.js
          grep -q 'SAKALUX_MISSION_API_ENHANCER_PARITY_V1039' SakaLuX-Mission-Rewards.user.js
          ! grep -q 'Minimal Torn API key' SakaLuX-Mission-Rewards.user.js
          grep -q 'CREATE MISSION API KEY' SakaLuX-Mission-Rewards.user.js
          grep -q 'SAVE NEW API KEY' SakaLuX-Mission-Rewards.user.js
          grep -q 'CHECK API ACCESS' SakaLuX-Mission-Rewards.user.js
          grep -q 'CLEAR LOCAL KEY' SakaLuX-Mission-Rewards.user.js

      - name: Commit
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add SakaLuX-Mission-Rewards.user.js scripts.json greasyfork/Mission-Rewards.md backups/mission-api-enhancer-parity-v1.0.39-2026-09-18/
          git commit -m 'Mission v1.0.39: match API Access to Enhancer'
          git push
