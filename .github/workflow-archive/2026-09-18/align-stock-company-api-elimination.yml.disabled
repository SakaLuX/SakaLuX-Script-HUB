name: Align Stock Company API with Elimination

on:
  push:
    paths:
      - '.github/align-stock-company-api-elimination.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Patch
        run: python3 .github/scripts/align_stock_company_api_elimination.py

      - name: Validate
        shell: bash
        run: |
          set -euo pipefail
          node --check SakaLuX-Stock-Manager-Advisor.user.js
          node --check SakaLuX-Company-Intelligence-v1.0.0.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q 'SAKALUX_STOCK_API_ELIMINATION_LAYOUT_V0716' SakaLuX-Stock-Manager-Advisor.user.js
          grep -q 'SAKALUX_COMPANY_ELIMINATION_LAYOUT_V1834' SakaLuX-Company-Intelligence-v1.0.0.user.js

      - name: Commit
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add SakaLuX-Stock-Manager-Advisor.user.js SakaLuX-Company-Intelligence-v1.0.0.user.js scripts.json greasyfork/Stock-Manager-Advisor.md greasyfork/Company-Intelligence.md backups/stock-company-elimination-api-layout-2026-09-18/
          git commit -m 'Stocks v0.7.16 + Company v1.8.34: align API UI with Elimination'
          git push
