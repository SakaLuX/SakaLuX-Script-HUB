name: Diagnose Market author footer

on:
  push:
    paths:
      - '.github/diagnose-market-author-footer.trigger'

permissions:
  contents: read

jobs:
  diagnose:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Show author/footer occurrences
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          files=['SakaLuX-Market-Intelligence.user.js','SakaLuX-Suite.user.js','SakaLuX-Script-Hub.user.js']
          for f in files:
              s=Path(f).read_text()
              print('\n===== '+f+' =====')
              needle='Made with ❤️'
              print('count:',s.count(needle))
              pos=0;n=0
              while True:
                  i=s.find(needle,pos)
                  if i<0: break
                  n+=1
                  print(f'\n--- occurrence {n} at {i} ---')
                  print(s[max(0,i-1400):min(len(s),i+1600)])
                  pos=i+len(needle)
          PY
