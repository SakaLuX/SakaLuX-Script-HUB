name: Fix Mission API Compact v1.0.40

on:
  push:
    paths:
      - '.github/mission-api-compact-v1040.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Patch Mission API compact UI
        run: python3 .github/scripts/fix_mission_api_compact_v1040.py

      - name: Validate
        shell: bash
        run: |
          set -euo pipefail
          node --check SakaLuX-Mission-Rewards.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      1.0.40' SakaLuX-Mission-Rewards.user.js
          grep -q 'SAKALUX_MISSION_API_COMPACT_V1040' SakaLuX-Mission-Rewards.user.js
          ! grep -q 'Exact permissions required</b><br>User: Ammo' SakaLuX-Mission-Rewards.user.js
          grep -q 'Exact permissions required</b>User: Ammo' SakaLuX-Mission-Rewards.user.js

      - name: Commit
        shell: bash
        run: |
          set -euo pipefail
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add SakaLuX-Mission-Rewards.user.js scripts.json greasyfork/Mission-Rewards.md backups/mission-api-compact-v1.0.40-2026-09-18/
          git commit -m 'Mission v1.0.40: compact API controls'
          git push
