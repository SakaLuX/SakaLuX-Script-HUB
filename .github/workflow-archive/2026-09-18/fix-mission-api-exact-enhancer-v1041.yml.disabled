name: Fix Mission API Exact Enhancer v1.0.41

on:
  push:
    paths:
      - '.github/mission-api-exact-enhancer-v1041.trigger'

permissions:
  contents: write

jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Patch
        run: python3 .github/scripts/fix_mission_api_exact_enhancer.py
      - name: Validate
        run: |
          set -euo pipefail
          node --check SakaLuX-Mission-Rewards.user.js
          python3 -m json.tool scripts.json >/dev/null
          grep -q '@version      1.0.41' SakaLuX-Mission-Rewards.user.js
          grep -q 'SAKALUX_MISSION_EXACT_ENHANCER_API_V1041' SakaLuX-Mission-Rewards.user.js
          grep -q 'CREATE MISSION API KEY' SakaLuX-Mission-Rewards.user.js
          grep -q 'User: Ammo' SakaLuX-Mission-Rewards.user.js
      - name: Commit
        run: |
          set -euo pipefail
          git config user.name 'SakaLuX Release Bot'
          git config user.email 'actions@users.noreply.github.com'
          git add SakaLuX-Mission-Rewards.user.js scripts.json greasyfork/Mission-Rewards.md backups/mission-api-exact-enhancer-v1.0.41-2026-09-18/
          git commit -m 'Mission v1.0.41: copy Enhancer API panel exactly'
          git push
